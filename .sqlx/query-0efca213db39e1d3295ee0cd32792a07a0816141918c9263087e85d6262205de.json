  "query": "SELECT id, workflow_id, name, kind, cron, next_run_at,\n                      secret_ciphertext IS NOT NULL AS \"has_secret!\", inputs, enabled,\n                      created_at, last_fired_at, last_error\n               FROM triggers\n               WHERE owner_id = $1 AND ($2::uuid IS NULL OR workflow_id = $2)\n               ORDER BY created_at",
