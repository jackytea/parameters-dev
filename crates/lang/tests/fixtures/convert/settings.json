{
  "parameters": 1,
  "name": "Every setting",
  "note": "Covers each statement once",
  "concurrency": 2,
  "inputs": [
    {
      "name": "name",
      "type": "text",
      "default": "world",
      "note": "Who to greet"
    },
    {
      "name": "count",
      "type": "number",
      "default": 3
    },
    {
      "name": "flags",
      "type": "object",
      "default": {
        "dry-run": true,
        "retries": [
          1,
          2
        ]
      }
    },
    {
      "name": "token",
      "type": "secret"
    }
  ],
  "steps": [
    {
      "id": "greet",
      "uses": "log.write",
      "note": "Says hello",
      "timeout": "1500ms",
      "with": {
        "message": {
          "$expr": "\"Hello, {name} \\{literal\\}\""
        }
      }
    },
    {
      "id": "wait",
      "uses": "time.wait",
      "after": [
        "greet"
      ],
      "when": "greet succeeded and not (count < 1 or count > 10)",
      "retry": 1,
      "with": {
        "duration": "2s"
      }
    },
    {
      "id": "call",
      "uses": "http.request",
      "after": [
        "greet",
        "wait"
      ],
      "with": {
        "url": {
          "$expr": "\"https://example.com/{name}\""
        },
        "headers": {
          "$expr": "{ Authorization: \"Bearer {token}\", \"X-Count\": count }"
        },
        "body": [
          1,
          -2.5,
          1e+100,
          true,
          "a\nb"
        ]
      }
    }
  ],
  "outputs": [
    {
      "name": "greeting",
      "value": {
        "$expr": "greet"
      }
    },
    {
      "name": "total",
      "type": "number",
      "value": {
        "$expr": "count"
      }
    }
  ],
  "definitions": {
    "fan.out": {
      "inputs": [
        {
          "name": "target",
          "type": "text"
        }
      ],
      "steps": [
        {
          "id": "first",
          "uses": "log.write",
          "with": {
            "message": {
              "$expr": "target"
            }
          }
        }
      ],
      "outputs": [
        {
          "name": "done",
          "type": "boolean",
          "value": {
            "$expr": "first succeeded"
          }
        }
      ]
    }
  }
}
